{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://workout-tracker-8048f.firebaseapp.com/__/auth/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-weekly-wrap",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/generate-insights",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/backup?type=daily",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/backup?type=weekly",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/backup?type=monthly",
      "schedule": "0 4 1 * *"
    }
  ]
}
