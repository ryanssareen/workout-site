rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Workouts collection
    match /workouts/{workoutId} {
      // Anyone authenticated can read workouts
      allow read: if request.auth != null;
      
      // Coaches can create/update/delete their own workouts
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
      
      // STUDENTS CAN MARK COMPLETE - including completedLate field
      allow update: if request.auth != null 
                    && request.auth.uid == resource.data.assignedTo
                    && onlyUpdatingCompletionFields();
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        
        // Students can create comments on their workouts
        allow create: if request.auth != null 
                      && request.auth.uid == get(/databases/$(database)/documents/workouts/$(workoutId)).data.assignedTo;
        
        // Users can delete their own comments
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }
    
    // Helper function - only allow completion field updates (INCLUDING completedLate)
    function onlyUpdatingCompletionFields() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['completed', 'completedAt', 'completionNotes', 'completedBy', 'completedLate', 'updatedAt', 'reminderSent']);
    }
  }
}
